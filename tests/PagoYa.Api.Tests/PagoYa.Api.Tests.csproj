<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de integración del licensing-backend. Ejercitan el CICLO COMPLETO a
    nivel de servicio (sin HTTP): ServicioLicencias emite/activa, EmisorTokens
    firma con RSA-2048 y el validador del CLIENTE (PagoYa.Licensing) verifica el
    token. Así queda blindado el contrato cliente↔server (nombres JSON, formato
    payload.firma, algoritmo de firma) y las reglas de dominio (HWID, traslados,
    expiración) frente a regresiones.

    TFM net8.0 heredado de ..\..\Directory.Build.props. Referencia el shared
    framework de ASP.NET porque PagoYa.Api es un proyecto Web SDK.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\PagoYa.Api\PagoYa.Api.csproj" />
    <ProjectReference Include="..\..\src\PagoYa.Licensing\PagoYa.Licensing.csproj" />
  </ItemGroup>

</Project>
