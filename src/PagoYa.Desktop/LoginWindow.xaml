<Window x:Class="PagoYa.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
        xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="PagoYa — Acceso"
        Icon="/Assets/logo.png"
        Height="700" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="White">

    <Window.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
        <conv:PackUriAImagenConverter x:Key="PackImg" />

        <!-- Input Fluent: borde fino gris, radio 4, acento naranja al enfocar -->
        <Style x:Key="FlInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="CaretBrush" Value="#201F1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A6A6A6" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Fluent (mismo look que FlInput) -->
        <Style x:Key="FlPassword" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="CaretBrush" Value="#201F1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A6A6A6" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario (acento) estilo Fluent -->
        <Style x:Key="FlPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Contenido ===== -->
        <StackPanel Grid.Row="0" Margin="40,22,40,8" MaxWidth="520" HorizontalAlignment="Left">
            <!-- Logo de PagoYa (solo el ícono), centrado arriba -->
            <Image Source="/Assets/logo.png" Width="66" Height="66" HorizontalAlignment="Center" Margin="0,4,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- ============ Paso 1: login / crear cuenta ============ -->
            <StackPanel Visibility="{Binding PedirRubro, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                <!-- Encabezado: ícono usuarios + título -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource Brush.PrimaryTint}"
                            VerticalAlignment="Center">
                        <Image Source="/Assets/Iconos/ico-usuarios.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Titulo" FontSize="22" FontWeight="SemiBold" Foreground="#201F1E" />
                        <TextBlock x:Name="Subtitulo" FontSize="13.5" Foreground="#605E5C"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="#EDEDED" Margin="0,18,0,20" />

                <StackPanel Visibility="{Binding ModoSetup, Converter={StaticResource BoolAVis}}">
                    <TextBlock Text="Nombre del administrador" FontSize="14" FontWeight="SemiBold"
                               Foreground="#201F1E" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="NombreBox" Style="{StaticResource FlInput}" Text="{Binding NombreCompleto}" />
                        <TextBlock Text="ej. Juan Pérez" IsHitTestVisible="False" Foreground="#9AA0A6"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding Text, ElementName=NombreBox, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="Usuario" FontSize="14" FontWeight="SemiBold" Foreground="#201F1E" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <TextBox x:Name="UsuarioBox" Style="{StaticResource FlInput}"
                             Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ej. admin" IsHitTestVisible="False" Foreground="#9AA0A6"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Text, ElementName=UsuarioBox, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                </Grid>

                <TextBlock Text="Contraseña" FontSize="14" FontWeight="SemiBold" Foreground="#201F1E" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,14">
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource FlPassword}" Padding="10,8,44,8" />
                    <TextBox x:Name="PasswordTextoBox" Style="{StaticResource FlInput}" Padding="10,8,44,8"
                             Visibility="Collapsed" />
                    <Button x:Name="BtnVer1" Click="ToggleVerClave1" HorizontalAlignment="Right"
                            Width="42" Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            ToolTip="Mostrar u ocultar la contraseña">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="OjoIcon1" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#605E5C" />
                    </Button>
                </Grid>

                <StackPanel Visibility="{Binding ModoSetup, Converter={StaticResource BoolAVis}}">
                    <TextBlock Text="Confirmar contraseña" FontSize="14" FontWeight="SemiBold"
                               Foreground="#201F1E" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <PasswordBox x:Name="PasswordConfirmarBox" Style="{StaticResource FlPassword}" Padding="10,8,44,8" />
                        <TextBox x:Name="PasswordConfirmarTextoBox" Style="{StaticResource FlInput}" Padding="10,8,44,8"
                                 Visibility="Collapsed" />
                        <Button x:Name="BtnVer2" Click="ToggleVerClave2" HorizontalAlignment="Right"
                                Width="42" Focusable="False" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                ToolTip="Mostrar u ocultar la contraseña">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="OjoIcon2" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#605E5C" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Border Background="#FDE7E9" CornerRadius="4" Padding="12,9" Margin="0,2,0,0"
                        Visibility="{Binding MensajeError, Converter={StaticResource BoolAVis}}">
                    <TextBlock Text="{Binding MensajeError}" Foreground="#A80000" FontSize="13" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- ============ Paso 2: elegir rubro del negocio ============ -->
            <StackPanel Visibility="{Binding PedirRubro, Converter={StaticResource BoolAVis}}">
                <TextBlock Text="¿Qué tipo de negocio tienes?" FontSize="22" FontWeight="SemiBold" Foreground="#201F1E" />
                <TextBlock Text="Elige tu rubro y dejamos el POS con categorías y productos de ejemplo listos para vender."
                           FontSize="13.5" Foreground="#605E5C" TextWrapping="Wrap" Margin="0,4,0,14" />
                <ScrollViewer MaxHeight="392" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rubros}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Cursor="Hand" Margin="4" BorderThickness="0"
                                        Command="{Binding DataContext.ElegirRubroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Clave}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="8" Background="White"
                                                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="14,12">
                                                <StackPanel>
                                                    <Grid Height="44" HorizontalAlignment="Left">
                                                        <Image Width="40" Height="40" HorizontalAlignment="Left"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding IconoImagen, Converter={StaticResource PackImg}}"
                                                               Visibility="{Binding IconoImagen, Converter={StaticResource BoolAVis}}" />
                                                        <TextBlock Text="{Binding Icono}" FontSize="28" VerticalAlignment="Center"
                                                                   Visibility="{Binding IconoImagen, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="14.5"
                                                               Foreground="#201F1E" TextWrapping="Wrap" Margin="0,6,0,2" />
                                                    <TextBlock Text="{Binding Descripcion}" FontSize="12" Foreground="#8A94A6"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryTint}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- ===== Barra de acciones inferior (solo en el paso login/crear cuenta) ===== -->
        <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0"
                Visibility="{Binding PedirRubro, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
            <Button x:Name="BtnEntrar" Content="{Binding TituloAccion}" Style="{StaticResource FlPrimary}"
                    Command="{Binding EntrarCommand}" IsDefault="True"
                    HorizontalAlignment="Right" Margin="24,16" MinWidth="150" />
        </Border>
    </Grid>
</Window>
