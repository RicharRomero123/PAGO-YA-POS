<Window x:Class="PagoYa.Desktop.ActivacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
        xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ActivacionViewModel}"
        Title="Activar PagoYa"
        Icon="/Assets/logo.png"
        Height="690" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="White">

    <Window.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />

        <!-- Input Fluent: borde fino gris, radio 4, acento naranja al enfocar -->
        <Style x:Key="FlInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="CaretBrush" Value="#201F1E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A6A6A6" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario (acento) estilo Fluent -->
        <Style x:Key="FlPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.PrimaryPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón estándar (blanco con borde) estilo Fluent -->
        <Style x:Key="FlDefault" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="#D1D1D1" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A6A6A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acción tipo enlace (command link) -->
        <Style x:Key="FlLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{StaticResource Brush.PrimaryPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Contenido (alineado a la izquierda) ===== -->
        <StackPanel Grid.Row="0" Margin="40,20,40,8" MaxWidth="500" HorizontalAlignment="Left">
            <!-- Logo de PagoYa (solo el ícono), centrado arriba -->
            <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,4,0,18"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Encabezado: candado + "Activar Licencia", a la izquierda -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource Brush.PrimaryTint}"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/Iconos/ico-candado.png" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Activar Licencia" FontSize="24" FontWeight="SemiBold" Foreground="#201F1E"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="#EDEDED" Margin="0,18,0,22" />

            <!-- HWID -->
            <TextBlock Text="Código de este equipo" FontSize="14" FontWeight="SemiBold" Foreground="#201F1E"
                       Margin="0,0,0,6" />
            <TextBox Style="{StaticResource FlInput}" Text="{Binding Hwid, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,22">
                <Button Style="{StaticResource FlDefault}" Content="Copiar" Command="{Binding CopiarHwidCommand}" />
                <Button Style="{StaticResource FlDefault}" Content="Guardar en archivo"
                        Command="{Binding GuardarHwidArchivoCommand}" Margin="10,0,0,0"
                        ToolTip="Guardar el código en un archivo .txt (para enviarlo desde otro equipo)" />
            </StackPanel>

            <!-- Token -->
            <TextBlock Text="Clave de licencia" FontSize="14" FontWeight="SemiBold" Foreground="#201F1E"
                       Margin="0,0,0,6" />
            <TextBox Style="{StaticResource FlInput}" MinHeight="80" FontFamily="Consolas" FontSize="12.5"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Text="{Binding TokenLicencia, UpdateSourceTrigger=PropertyChanged}" />
            <Button Style="{StaticResource FlDefault}" Command="{Binding ImportarLicenciaArchivoCommand}"
                    Margin="0,10,0,0" HorizontalAlignment="Left"
                    ToolTip="Elige el archivo de licencia (.lic/.txt) que te enviaron">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Iconos/ico-subir.png" Width="16" Height="16" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Importar archivo" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Mensaje neutro -->
            <TextBlock Text="{Binding MensajeEstado}" Foreground="{StaticResource Brush.Primary}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}" />

            <!-- Mensaje de error -->
            <Border Background="#FDE7E9" CornerRadius="4" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding MensajeError, Converter={StaticResource BoolAVis}}">
                <TextBlock Text="{Binding MensajeError}" Foreground="#A80000" FontSize="13" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ===== Barra de acciones inferior (estilo diálogo Windows) ===== -->
        <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                <Button Content="Activar" Style="{StaticResource FlPrimary}" Command="{Binding ActivarCommand}"
                        IsDefault="True" MinWidth="120" />
                <Button Content="Salir" Style="{StaticResource FlDefault}" Click="Salir_Click"
                        MinWidth="96" Margin="10,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
