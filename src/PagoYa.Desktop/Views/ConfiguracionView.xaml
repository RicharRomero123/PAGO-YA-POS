<UserControl x:Class="PagoYa.Desktop.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ConfiguracionViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
        <conv:RutaAImagenConverter x:Key="Img" />
        <Style x:Key="ComboEstandar" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FuenteUI}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Pestañas tipo chip -->
        <Style x:Key="TabPill" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Navy}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" CornerRadius="0" Padding="18,10" Margin="0,0,8,0"
                                Background="White" BorderBrush="#E2E6EC" BorderThickness="1.5">
                            <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold" TextBlock.FontSize="14"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Primary}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Configuración" Style="{StaticResource H1}" Margin="0,0,0,16" />

        <!-- Barra inferior: guardar (aplica a Negocio/Impresora/Nube) -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{Binding MensajeEstado}" Style="{StaticResource Body}"
                       Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"
                       Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}" />
            <Button Content="Guardar cambios" Style="{StaticResource BotonPrimario}"
                    Command="{Binding GuardarCommand}" HorizontalAlignment="Right" MinWidth="160" />
        </Grid>

        <TabControl Background="Transparent" BorderThickness="0" Padding="0" MaxWidth="860" HorizontalAlignment="Left">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabPill}" />
            </TabControl.Resources>

            <!-- ============ NEGOCIO ============ -->
            <TabItem Header="Negocio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Datos del negocio" Style="{StaticResource H2}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre del negocio" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding NombreNegocio}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Rubro / giro" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <ComboBox Style="{StaticResource ComboEstandar}" ItemsSource="{Binding Rubros}"
                                              SelectedValuePath="Clave" DisplayMemberPath="Nombre"
                                              SelectedValue="{Binding RubroClave}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RUC" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding Ruc}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dirección" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding Direccion}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Teléfono" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding Telefono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pie del ticket" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding PieTicket}" />
                                </StackPanel>
                            </Grid>

                            <!-- Logo del local -->
                            <TextBlock Text="Logo del local" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="96" Height="96" Background="#F1F3F7"
                                        BorderBrush="{StaticResource Brush.Borde}" BorderThickness="1.5">
                                    <Grid>
                                        <TextBlock Text="&#x1F3EA;" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.5"
                                                   Visibility="{Binding TieneLogo, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                                        <Image Source="{Binding LogoRuta, Converter={StaticResource Img}}" Stretch="Uniform" Margin="6"
                                               Visibility="{Binding TieneLogo, Converter={StaticResource BoolAVis}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Cargar logo…" Style="{StaticResource BotonSecundario}"
                                            HorizontalAlignment="Left" Command="{Binding CargarLogoCommand}" />
                                    <Button Content="Quitar logo" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource Brush.Error}" FontSize="13" Cursor="Hand"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="2,0"
                                            Command="{Binding QuitarLogoCommand}"
                                            Visibility="{Binding TieneLogo, Converter={StaticResource BoolAVis}}" />
                                    <TextBlock Text="Se muestra en la vista previa del ticket."
                                               Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ IMPRESORA ============ -->
            <TabItem Header="Impresora y cajón">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Impresora de tickets" Style="{StaticResource H2}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Impresora" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <ComboBox Style="{StaticResource ComboEstandar}"
                                              ItemsSource="{Binding ImpresorasDisponibles}"
                                              SelectedItem="{Binding ImpresoraSeleccionada}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ancho papel" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                    <ComboBox Style="{StaticResource ComboEstandar}"
                                              ItemsSource="{Binding OpcionesAncho}"
                                              SelectedItem="{Binding AnchoPapel}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Abrir el cajón de dinero automáticamente al cobrar en efectivo"
                                      IsChecked="{Binding AbrirCajonEnEfectivo}"
                                      FontFamily="{StaticResource FuenteUI}" FontSize="15"
                                      Margin="0,14,0,0" VerticalContentAlignment="Center" />
                            <TextBlock Text="El cajón se conecta al puerto RJ11/RJ12 de la impresora térmica."
                                       Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Imprimir página de prueba" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ImprimirPruebaCommand}" />
                                <Button Content="Probar cajón" Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ProbarCajonCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ NUBE ============ -->
            <TabItem Header="Nube">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Nube (respaldo y multi-caja)" Style="{StaticResource H2}" Margin="0,0,0,12" />
                            <TextBlock Text="URL del servidor de sincronización" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputEstandar}"
                                     Text="{Binding SyncUrlBase, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Ej. https://api.pagoya.pe — la proporciona soporte al activar el plan Cloud. Si la dejas vacía, el respaldo trabaja solo en este equipo (offline). Al cambiarla debes reiniciar PagoYa." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============ LICENCIA ============ -->
            <TabItem Header="Licencia y plan">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Licencia y plan" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Style="{StaticResource BadgeTier}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Plan: " Style="{StaticResource ChipTexto}" Foreground="{StaticResource Brush.Primary}" />
                                        <TextBlock Text="{Binding PlanActual}" Style="{StaticResource ChipTexto}" Foreground="{StaticResource Brush.Primary}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource Brush.WarningTint}" CornerRadius="0" Padding="14,10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding EnPeriodoGracia, Converter={StaticResource BoolAVis}}">
                                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Brush.Warning}"
                                           Text="Tu licencia venció y estás en periodo de gracia. Renueva para no perder las funciones premium." TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding DetalleLicencia}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="ID de este equipo (HWID)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputEstandar}"
                                         Text="{Binding Hwid, Mode=OneWay}" IsReadOnly="True" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Copiar" Style="{StaticResource BotonSecundario}"
                                            Command="{Binding CopiarHwidCommand}" />
                                    <Button Content="Guardar a archivo" Style="{StaticResource BotonSecundario}"
                                            Command="{Binding GuardarHwidArchivoCommand}" Margin="8,0,0,0"
                                            ToolTip="Guardar el código en un .txt para llevarlo en USB (equipos sin internet)" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Activar licencia (pega tu token o impórtalo desde archivo)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputEstandar}" MinHeight="70"
                                     Text="{Binding TokenLicencia, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Activar / actualizar plan" Style="{StaticResource BotonPrimario}"
                                        Command="{Binding ActivarLicenciaCommand}" />
                                <Button Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ImportarLicenciaArchivoCommand}" Margin="8,0,0,0"
                                        ToolTip="Importar el token desde un archivo .lic/.txt">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#128196;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Importar archivo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding MensajeLicencia}" Style="{StaticResource Body}"
                                       Foreground="{StaticResource Brush.Primary}" TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding MensajeLicencia, Converter={StaticResource BoolAVis}}" />

                            <Border Background="{StaticResource Brush.WarningTint}" CornerRadius="0" Padding="14,10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding RequiereReinicio, Converter={StaticResource BoolAVis}}">
                                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Brush.Warning}"
                                           Text="Cierra y vuelve a abrir PagoYa para terminar de activar los módulos premium."
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
