<UserControl x:Class="PagoYa.Desktop.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReportesViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:MonedaSolesConverter x:Key="Moneda" />
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </UserControl.Resources>

    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Reportes del día" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Fecha}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                <TextBlock Text="Aún no hay ventas registradas hoy. Cobra tu primera venta para ver las métricas."
                           Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Foreground="{StaticResource Brush.Primary}"
                           Visibility="{Binding SinVentas, Converter={StaticResource BoolAVis}}" />
            </StackPanel>

            <!-- Exportar a Excel por rango de fechas -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Tarjeta}" Padding="14,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Desde" Style="{StaticResource Muted}" FontSize="11" />
                        <DatePicker SelectedDate="{Binding ExportDesde}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Hasta" Style="{StaticResource Muted}" FontSize="11" />
                        <DatePicker SelectedDate="{Binding ExportHasta}" Width="130" />
                    </StackPanel>
                    <Button Content="&#x2B07; Exportar a Excel" Style="{StaticResource BotonPrimario}"
                            VerticalAlignment="Bottom" Command="{Binding ExportarExcelCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Métricas -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,6,0" Background="{StaticResource Brush.Navy}">
                <StackPanel>
                    <TextBlock Text="Total vendido" Foreground="#C9D4E3" FontSize="14" />
                    <TextBlock Text="{Binding TotalVendido, Converter={StaticResource Moneda}}"
                               FontFamily="{StaticResource FuenteMarca}" FontSize="30"
                               FontWeight="ExtraBold" Foreground="White" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="N.° de ventas" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding CantidadVentas}" Style="{StaticResource Precio}" FontSize="30" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Ticket promedio" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding TicketPromedio, Converter={StaticResource Moneda}}"
                               Style="{StaticResource Precio}" FontSize="30" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tarjeta}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Productos vendidos" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ProductosVendidos}" Style="{StaticResource Precio}" FontSize="30" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Aviso de estado (reimpresión / exportación) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Navy}" Padding="14,10" Margin="0,14,0,0"
                HorizontalAlignment="Left"
                Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}">
            <TextBlock Text="{Binding MensajeEstado}" Foreground="White" FontSize="13" />
        </Border>

        <!-- Listas -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Últimas ventas -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Últimas ventas" Style="{StaticResource H2}" Margin="20,18,20,10" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Borde}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,8">
                        <ItemsControl ItemsSource="{Binding UltimasVentas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Hora}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Metodo}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Total, Converter={StaticResource Moneda}}" Style="{StaticResource Body}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Grid.Column="4" Content="&#x1F441; Ver ticket" VerticalAlignment="Center" Margin="0,0,10,0"
                                                Style="{StaticResource BotonSecundario}" Padding="10,5" FontSize="12"
                                                ToolTip="Ver vista previa e imprimir"
                                                Command="{Binding DataContext.VerTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Border Grid.Column="5" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ChipPagado}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsAnulado}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Brush.ErrorTint}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Estado}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipTexto}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsAnulado}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Columna derecha: Más vendidos + desglose por método -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Más vendidos -->
                <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Más vendidos" Style="{StaticResource H2}" Margin="20,18,20,10" />
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Borde}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,8">
                            <ItemsControl ItemsSource="{Binding MasVendidos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Nombre}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="13">
                                                    <Run Text="{Binding Unidades, Mode=OneWay}" /><Run Text=" und" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Total, Converter={StaticResource Moneda}}"
                                                       Style="{StaticResource Body}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Cobros por método de pago (conciliación de caja) -->
                <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Cobros por método" Style="{StaticResource H2}" Margin="20,18,20,10" />
                        <Border Height="1" Background="{StaticResource Brush.Borde}" />
                        <ItemsControl ItemsSource="{Binding PorMetodo}" Margin="20,8,20,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Metodo}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Run Text="{Binding Cantidad, Mode=OneWay}" /><Run Text=" ventas" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Total, Converter={StaticResource Moneda}}"
                                                   Style="{StaticResource Body}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
