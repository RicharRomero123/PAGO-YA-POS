<UserControl x:Class="PagoYa.Desktop.Views.UpsellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UpsellViewModel}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </UserControl.Resources>

    <!-- Overlay modal premium; visible solo cuando se abre un módulo bloqueado -->
    <Grid Visibility="{Binding Visible, Converter={StaticResource BoolAVis}}"
          Background="#99101B2E">
        <Border Style="{StaticResource Tarjeta}" MaxWidth="560" Padding="0"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="0">
            <StackPanel>
                <!-- Cabecera naranja de marca -->
                <Border CornerRadius="0" Padding="28,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Color.Primary}" Offset="0" />
                            <GradientStop Color="{StaticResource Color.PrimaryPressed}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icono}" FontSize="36" VerticalAlignment="Center" />
                            <Border Background="#33FFFFFF" CornerRadius="2" Padding="12,5"
                                    Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒 Requiere " FontSize="13" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding TierRequerido}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Titulo}" FontFamily="{StaticResource FuenteMarca}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,14,0,4" />
                        <TextBlock Text="{Binding Precio}" FontSize="16" FontWeight="Bold" Foreground="#FFE4D3" />
                    </StackPanel>
                </Border>

                <!-- Cuerpo -->
                <StackPanel Margin="28,20">
                    <TextBlock Text="{Binding Gancho}" Style="{StaticResource Body}" FontSize="17"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontWeight="Bold" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Beneficio1}" Style="{StaticResource Body}" TextWrapping="Wrap" Width="420" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontWeight="Bold" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Beneficio2}" Style="{StaticResource Body}" TextWrapping="Wrap" Width="420" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource Brush.Success}" FontWeight="Bold" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Beneficio3}" Style="{StaticResource Body}" TextWrapping="Wrap" Width="420" />
                        </StackPanel>
                    </StackPanel>

                    <!-- CTAs -->
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Ahora no" Style="{StaticResource BotonSecundario}"
                                Command="{Binding CerrarCommand}" Margin="0,0,12,0" MinWidth="120" />
                        <Button Grid.Column="1" Content="Mejora tu plan" Style="{StaticResource BotonPrimario}"
                                Command="{Binding MejorarPlanCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
