<UserControl x:Class="PagoYa.Desktop.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CajaViewModel}"
             Background="#EEF1F5">
    <UserControl.Resources>
        <conv:MonedaSolesConverter x:Key="Moneda" />
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- ===== Encabezado ===== -->
            <TextBlock Text="Caja" Style="{StaticResource H1}" Margin="0,0,0,12" />

            <!-- ===== Banner de estado / flujo ===== -->
            <Border Background="#12233F" Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Estado -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EF4444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                <Setter Property="Background" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Foreground="White" FontSize="22" FontWeight="ExtraBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="CAJA CERRADA" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CajaAbierta}" Value="True">
                                                <Setter Property="Text" Value="CAJA ABIERTA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Foreground="#9FB2CC" FontSize="13" Margin="20,4,0,0">
                            <Run Text="Cajero:" /><Run Text=" " /><Run Text="{Binding Cajero, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="   ·   Apertura:" /><Run Text=" " /><Run Text="{Binding HoraApertura, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Esperado en caja -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolAVis}}">
                        <TextBlock Text="ESPERADO EN CAJA" Foreground="#7E92AE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding EsperadoEnCaja, Converter={StaticResource Moneda}}"
                                   Foreground="White" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- Abrir caja -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Visibility="{Binding CajaAbierta, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                        <TextBlock Text="Fondo inicial (S/)" Foreground="#9FB2CC" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="110" Height="40" FontSize="16" VerticalContentAlignment="Center"
                                     Text="{Binding MontoAperturaNueva, StringFormat=N2}" />
                            <Button Content="&#x1F513; Abrir caja" Style="{StaticResource BotonPrimario}" Height="40" Margin="8,0,0,0"
                                    Command="{Binding AbrirCajaCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Tarjetas de resumen (solo con caja abierta) ===== -->
            <UniformGrid Columns="4" Margin="0,0,0,16"
                         Visibility="{Binding CajaAbierta, Converter={StaticResource BoolAVis}}">
                <!-- Fondo inicial -->
                <Border Background="#FFF4D6" BorderBrush="#F5B301" BorderThickness="0,0,0,4" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#F5B301" Margin="0,0,8,0">
                                <TextBlock Text="&#x1F4B0;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Fondo inicial" Foreground="#8A6D00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding MontoInicial, Converter={StaticResource Moneda}}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="#7A5B00" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <!-- Ventas efectivo -->
                <Border Background="#DDF7E6" BorderBrush="#16A34A" BorderThickness="0,0,0,4" Padding="16" Margin="3,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#16A34A" Margin="0,0,8,0">
                                <TextBlock Text="&#x1F4B5;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Ventas efectivo" Foreground="#0F7A38" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VentasEfectivo, Converter={StaticResource Moneda}}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="#0F7A38" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <!-- Yape / Plin -->
                <Border Background="#EEE5FF" BorderBrush="#7C3AED" BorderThickness="0,0,0,4" Padding="16" Margin="3,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#7C3AED" Margin="0,0,8,0">
                                <TextBlock Text="&#x1F4F1;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Yape / Plin" Foreground="#6D28D9" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VentasDigital, Converter={StaticResource Moneda}}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="#6D28D9" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <!-- Tarjeta -->
                <Border Background="#E0ECFF" BorderBrush="#2563EB" BorderThickness="0,0,0,4" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Background="#2563EB" Margin="0,0,8,0">
                                <TextBlock Text="&#x1F4B3;" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Tarjeta" Foreground="#1D4ED8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VentasTarjeta, Converter={StaticResource Moneda}}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="#1D4ED8" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Arqueo + Flujo (movimientos) ===== -->
            <Grid Margin="0,0,0,16" Visibility="{Binding CajaAbierta, Converter={StaticResource BoolAVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Arqueo / cierre -->
                <Border Grid.Column="0" Background="White" BorderBrush="#D5DBE3" BorderThickness="1"
                        Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="&#x1F4CB; Cierre de caja (arqueo)" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <TextBlock Text="Efectivo contado" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputEstandar}" FontSize="20"
                                 Text="{Binding MontoContado, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                        <Border Background="#F4F6F9" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <TextBlock Text="Esperado" Style="{StaticResource Muted}" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold" Foreground="#12233F"
                                           Text="{Binding EsperadoEnCaja, Converter={StaticResource Moneda}}" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Diferencia" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" FontSize="20" FontWeight="ExtraBold"
                                       Text="{Binding Diferencia, Converter={StaticResource Moneda}}" Foreground="#12233F" />
                        </Grid>

                        <Button Content="&#x1F512; Cerrar caja" Style="{StaticResource BotonPrimario}"
                                Margin="0,18,0,0" Height="46" Command="{Binding CerrarCajaCommand}"
                                IsEnabled="{Binding CajaAbierta}" />
                        <TextBlock Text="{Binding MensajeEstado}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}" />
                    </StackPanel>
                </Border>

                <!-- Flujo de la caja (movimientos) -->
                <Border Grid.Column="2" Background="White" BorderBrush="#D5DBE3" BorderThickness="1" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="&#x1F504; Flujo de la caja (movimientos de hoy)"
                                   Style="{StaticResource H2}" Margin="18,16,18,10" />
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Borde}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,6" MaxHeight="320">
                            <ItemsControl ItemsSource="{Binding Movimientos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Hora}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="#EEF1F5" Padding="8,3">
                                                    <TextBlock Text="{Binding Tipo}" FontSize="12" FontWeight="Bold" Foreground="#12233F" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Detalle}" Style="{StaticResource Muted}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding Monto, Converter={StaticResource Moneda}}"
                                                           FontWeight="Bold" Foreground="#12233F" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== Historial de cajas por fechas ===== -->
            <Border Background="White" BorderBrush="#D5DBE3" BorderThickness="1" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,16,18,12">
                        <TextBlock Text="&#x1F4C5; Historial de cajas" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Desde" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding HistorialDesde}" Width="130" />
                            <TextBlock Text="Hasta" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <DatePicker SelectedDate="{Binding HistorialHasta}" Width="130" />
                            <Button Content="Ver" Style="{StaticResource BotonSecundario}" Margin="10,0,0,0"
                                    Command="{Binding CargarHistorialCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Borde}" />

                    <!-- Cabecera de columnas -->
                    <Grid DockPanel.Dock="Top" Margin="18,10,18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fecha" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="Apertura" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="Cierre" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="3" Text="Cajero" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="4" Text="Fondo" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="5" Text="Contado" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="6" Text="Diferencia" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="7" Text="Estado" Style="{StaticResource Muted}" FontWeight="Bold" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Brush.Borde}" />

                    <TextBlock DockPanel.Dock="Top" Text="No hay cajas en el rango elegido."
                               Style="{StaticResource Muted}" Margin="18,14" HorizontalAlignment="Center"
                               Visibility="{Binding HistorialVacio, Converter={StaticResource BoolAVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,18,8" MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Historial}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Fecha}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Apertura}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Cierre}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Cajero}" Style="{StaticResource Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding FondoTexto}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding ContadoTexto}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding DiferenciaTexto}" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#12233F" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Faltante}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Sobrante}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Cuadrada}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Brush.SuccessTint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Abierta}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.WarningTint}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Abierta}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
