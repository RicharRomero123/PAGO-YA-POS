<UserControl x:Class="PagoYa.Desktop.Views.VencimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VencimientosViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />

        <!-- Plantilla de fila reutilizada por todas las secciones. El color del borde
             izquierdo lo fija cada ItemsControl con su propio Tag/estilo externo, así que
             aquí usamos un acento neutro; cada sección envuelve la lista en su tarjeta. -->
        <DataTemplate x:Key="FilaVencimiento">
            <Border BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1" Background="Transparent" Padding="0,2">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Producto + lote -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Nombre}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Categoria}" Style="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Text="{Binding LoteTexto, StringFormat={} · {0}}" Style="{StaticResource Muted}" FontSize="11"
                                       Visibility="{Binding TieneLote, Converter={StaticResource BoolAVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Estado temporal -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiasTexto}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding FechaVencimientoTexto}" Style="{StaticResource Muted}" FontSize="11"
                                   Visibility="{Binding TieneVencimiento, Converter={StaticResource BoolAVis}}" />
                    </StackPanel>

                    <!-- Stock -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Stock" Style="{StaticResource Muted}" FontSize="10" />
                        <TextBlock Text="{Binding StockTexto}" Style="{StaticResource Body}" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Proveedor -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="Proveedor" Style="{StaticResource Muted}" FontSize="10" />
                        <TextBlock Text="{Binding ProveedorTexto}" Style="{StaticResource Muted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Avisar por WhatsApp -->
                    <Button Grid.Column="4" VerticalAlignment="Center" Cursor="Hand" BorderThickness="0" Padding="12,7"
                            Background="#25D366"
                            Command="{Binding DataContext.AvisarProveedorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Enviar aviso de reposición por WhatsApp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4AC;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Avisar proveedor" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="24">
            <!-- Encabezado + resumen -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4C5;" FontSize="30" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vencimientos y reposición" Style="{StaticResource H1}" />
                        <TextBlock Text="Controla vencidos, próximos a vencer y stock bajo. Avisa a tu proveedor en un toque." Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <!-- Contadores resumen -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FDE2E2" CornerRadius="10" Padding="14,8" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalVencidos}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Error}" HorizontalAlignment="Center" />
                            <TextBlock Text="Vencidos" FontSize="11" Foreground="{StaticResource Brush.Error}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF3D9" CornerRadius="10" Padding="14,8" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPorVencer30}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center" />
                            <TextBlock Text="≤ 30 días" FontSize="11" Foreground="{StaticResource Brush.Warning}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#E0ECFF" CornerRadius="10" Padding="14,8" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalReposicion}" FontSize="22" FontWeight="ExtraBold" Foreground="#2563EB" HorizontalAlignment="Center" />
                            <TextBlock Text="Reponer" FontSize="11" Foreground="#2563EB" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Estado: todo en orden -->
                    <Border Style="{StaticResource Tarjeta}" Padding="24" Margin="0,0,0,14"
                            Visibility="{Binding SinAlertas, Converter={StaticResource BoolAVis}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,20">
                            <TextBlock Text="&#x2705;" FontSize="42" HorizontalAlignment="Center" />
                            <TextBlock Text="Todo en orden" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="No hay medicamentos vencidos, por vencer ni con stock bajo." Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- ===== VENCIDOS (rojo) ===== -->
                    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14"
                            Visibility="{Binding TotalVencidos, Converter={StaticResource BoolAVis}}">
                        <StackPanel>
                            <Border Background="#FDE2E2" Padding="16,10" CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Brush.Error}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalVencidos}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="Vencidos — retirar del anaquel" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource Brush.Error}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Vencidos}" ItemTemplate="{StaticResource FilaVencimiento}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== POR VENCER ≤30 (ámbar) ===== -->
                    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14"
                            Visibility="{Binding TotalPorVencer30, Converter={StaticResource BoolAVis}}">
                        <StackPanel>
                            <Border Background="#FEF3D9" Padding="16,10" CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource Brush.Warning}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalPorVencer30}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="Por vencer en 30 días — priorizar rotación" FontWeight="Bold" FontSize="15"
                                               Foreground="#B45309" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding PorVencer30}" ItemTemplate="{StaticResource FilaVencimiento}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== POR VENCER ≤60 (ámbar suave) ===== -->
                    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14"
                            Visibility="{Binding TotalPorVencer60, Converter={StaticResource BoolAVis}}">
                        <StackPanel>
                            <Border Background="#FFF7E6" Padding="16,10" CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#D9A518" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalPorVencer60}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="Por vencer en 31–60 días — vigilar" FontWeight="Bold" FontSize="15"
                                               Foreground="#946A00" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding PorVencer60}" ItemTemplate="{StaticResource FilaVencimiento}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== STOCK BAJO / REPOSICIÓN (azul) ===== -->
                    <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,14"
                            Visibility="{Binding TotalReposicion, Converter={StaticResource BoolAVis}}">
                        <StackPanel>
                            <Border Background="#E0ECFF" Padding="16,10" CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#2563EB" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalReposicion}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                    </Border>
                                    <TextBlock Text="Stock bajo — reponer" FontWeight="Bold" FontSize="15"
                                               Foreground="#1D4ED8" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Reposicion}" ItemTemplate="{StaticResource FilaVencimiento}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Aviso de estado (efímero) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="{StaticResource Brush.Navy}" Padding="16,10"
                Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}">
            <TextBlock Text="{Binding MensajeEstado}" Foreground="White" FontSize="13" />
        </Border>
    </Grid>
</UserControl>
