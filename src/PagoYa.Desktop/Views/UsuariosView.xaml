<UserControl x:Class="PagoYa.Desktop.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UsuariosViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Usuarios" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding ResumenCupo}" Style="{StaticResource Muted}" />
                </StackPanel>
                <Button Content="+ Nuevo usuario" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoUsuarioCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- Aviso de límite / upsell -->
            <Border Background="{StaticResource Brush.WarningTint}" CornerRadius="0" Padding="16,14" Margin="0,0,0,16"
                    Visibility="{Binding MostrarLimite, Converter={StaticResource BoolAVis}}">
                <StackPanel>
                    <TextBlock Text="🔒 Límite del plan Base" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Warning}" FontSize="15" />
                    <TextBlock Text="El plan Base permite 1 administrador + 1 cajero. Con un plan premium agregas cajeros ilimitados, multi-caja y respaldo en la nube."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Button Content="Ver planes premium" Style="{StaticResource BotonPrimario}"
                            Command="{Binding IrAPlanesCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Formulario alta -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16"
                    Visibility="{Binding EditorVisible, Converter={StaticResource BoolAVis}}">
                <StackPanel>
                    <TextBlock Text="Nuevo usuario" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre completo" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputEstandar}" Text="{Binding FormNombreCompleto}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Usuario (login)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputEstandar}" Text="{Binding FormNombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contraseña" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PasswordNuevo" Style="{StaticResource PasswordEstandar}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rol" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox MinHeight="48" FontSize="16" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding RolesDisponibles}" SelectedItem="{Binding FormRol}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                                Command="{Binding CancelarEdicionCommand}" Margin="0,0,10,0" />
                        <Button Content="Guardar usuario" Style="{StaticResource BotonPrimario}"
                                Command="{Binding GuardarUsuarioCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding MensajeEstado}" Style="{StaticResource Body}"
                       Foreground="{StaticResource Brush.Primary}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}" />

            <!-- Lista -->
            <Border Style="{StaticResource Tarjeta}" Padding="0">
                <ItemsControl ItemsSource="{Binding Usuarios}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12" BorderBrush="{StaticResource Brush.Borde}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding NombreCompleto}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource Brush.Primary}" CornerRadius="2" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding EsSesionActual, Converter={StaticResource BoolAVis}}">
                                                <TextBlock Text="tú" Foreground="White" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="13">
                                            <Run Text="{Binding NombreUsuario, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Rol, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                            CornerRadius="2" Padding="8,3"
                                            Background="{StaticResource Brush.SuccessTint}"
                                            Visibility="{Binding Activo, Converter={StaticResource BoolAVis}}">
                                        <TextBlock Text="Activo" Foreground="{StaticResource Brush.Success}" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                    <Button Grid.Column="2" Content="Desactivar" Style="{StaticResource BotonSecundario}"
                                            Command="{Binding DataContext.DesactivarUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding Activo, Converter={StaticResource BoolAVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
