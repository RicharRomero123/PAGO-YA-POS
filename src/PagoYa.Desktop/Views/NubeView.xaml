<UserControl x:Class="PagoYa.Desktop.Views.NubeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NubeViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </UserControl.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Nube y respaldo" Style="{StaticResource H1}" />
            <TextBlock Text="Respalda tu negocio y consolida las ventas de todas tus cajas en la nube."
                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" MaxWidth="860" HorizontalAlignment="Left">
            <!-- Métricas -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,6,0" Background="{StaticResource Brush.Navy}">
                    <StackPanel>
                        <TextBlock Text="Pendientes por subir" Foreground="#C9D4E3" FontSize="14" />
                        <TextBlock Text="{Binding PendientesLocales}" FontFamily="{StaticResource FuenteMarca}"
                                   FontSize="30" FontWeight="ExtraBold" Foreground="White" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="Enviados (último)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Enviados}" Style="{StaticResource Precio}" FontSize="30" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recibidos (último)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Recibidos}" Style="{StaticResource Precio}" FontSize="30" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Respaldo manual -->
            <Border Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Respaldo manual" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">
                        <Run Text="Última sincronización: " /><Run Text="{Binding UltimaSync, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="El respaldo sube tus cambios locales y descarga los de otras cajas."
                               Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <Button Content="Respaldar ahora" Style="{StaticResource BotonPrimario}"
                            Command="{Binding SincronizarAhoraCommand}"
                            HorizontalAlignment="Left" MinWidth="180" />

                    <TextBlock Text="{Binding MensajeEstado}" Style="{StaticResource Body}"
                               Foreground="{StaticResource Brush.Primary}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
