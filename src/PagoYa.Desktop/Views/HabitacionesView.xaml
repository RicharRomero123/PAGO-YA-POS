<UserControl x:Class="PagoYa.Desktop.Views.HabitacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HabitacionesViewModel}"
             Background="{StaticResource Brush.Fondo}">
    <UserControl.Resources>
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
        <conv:EstadoHabitacionAColorConverter x:Key="EstadoColor" />
        <conv:RutaAImagenConverter x:Key="Img" />
    </UserControl.Resources>

    <Grid>
        <DockPanel Margin="24">
            <!-- Encabezado -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/Iconos/ico-hotel.png" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Habitaciones" Style="{StaticResource H1}" />
                        <TextBlock Text="Administra tus cuartos por piso. El alquiler se hace en Cobrar." Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Registrar habitación" Style="{StaticResource BotonPrimario}"
                        MinHeight="48" VerticalAlignment="Center" Command="{Binding NuevaHabitacionCommand}" />
            </Grid>

            <Border Style="{StaticResource Tarjeta}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Estado vacío -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60"
                                    Visibility="{Binding TotalHabitaciones, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                            <Image Width="64" Height="64" Opacity="0.5" HorizontalAlignment="Center"
                                   Source="pack://application:,,,/Assets/Iconos/ico-hotel.png" />
                            <TextBlock Text="Aún no tienes habitaciones registradas." Style="{StaticResource Muted}"
                                       Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Catálogo agrupado por piso -->
                        <ItemsControl ItemsSource="{Binding HabitacionesView}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,14,0,8">
                                                <Border Background="{StaticResource Brush.Navy}" CornerRadius="6" Padding="10,4">
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="14">
                                                        <Run Text="Piso" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} cuartos, Mode=OneWay}"
                                                           Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="240" Margin="6" CornerRadius="12" Background="White"
                                            BorderBrush="{StaticResource Brush.Borde}" BorderThickness="1.5">
                                        <StackPanel>
                                            <!-- Banner de foto (o placeholder con icono) -->
                                            <Border Height="110" CornerRadius="11,11,0,0" Background="#EEF1F5" ClipToBounds="True">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                                                        <Image Width="34" Height="34" Opacity="0.45" HorizontalAlignment="Center"
                                                               Source="pack://application:,,,/Assets/Iconos/ico-cama.png" />
                                                        <TextBlock Text="Sin foto" FontSize="11" Foreground="#9AA5B4" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <Image Source="{Binding ImagenRuta, Converter={StaticResource Img}}" Stretch="UniformToFill"
                                                           Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}}" />
                                                </Grid>
                                            </Border>
                                            <!-- Cabecera de la tarjeta -->
                                            <Grid Margin="14,12,14,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Numero}" FontSize="24" FontWeight="ExtraBold" Foreground="#12233F" />
                                                    <TextBlock Text="{Binding TipoTexto}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                                        Background="{Binding Estado, Converter={StaticResource EstadoColor}, ConverterParameter=Tint}">
                                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Estado, Converter={StaticResource EstadoColor}}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding PrecioTexto}" Style="{StaticResource Muted}" Margin="14,0,14,4" />
                                            <StackPanel Orientation="Horizontal" Margin="14,0,14,4">
                                                <TextBlock Text="Capacidad: " Style="{StaticResource Muted}" FontSize="12" />
                                                <TextBlock Text="{Binding Capacidad}" Style="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text=" pers." Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>

                                            <!-- Chips de comodidades -->
                                            <ItemsControl ItemsSource="{Binding ComodidadesLista}" Margin="12,0,12,6"
                                                          Visibility="{Binding TieneComodidades, Converter={StaticResource BoolAVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource Brush.PrimaryTint}" CornerRadius="9" Padding="7,3" Margin="0,2,4,0">
                                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Height="1" Background="{StaticResource Brush.Borde}" Margin="0,4,0,0" />
                                            <Grid Margin="6,4,6,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Editar" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold" Cursor="Hand" Padding="8,6"
                                                        Command="{Binding DataContext.EditarHabitacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="1" Content="Eliminar" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource Brush.Error}" FontWeight="SemiBold" Cursor="Hand" Padding="8,6"
                                                        Command="{Binding DataContext.EliminarHabitacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Aviso de estado -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="{StaticResource Brush.Navy}" Padding="16,10"
                Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}">
            <TextBlock Text="{Binding MensajeEstado}" Foreground="White" FontSize="13" />
        </Border>

        <!-- ============ Editor de habitación (overlay) ============ -->
        <Grid Background="#88000000" Visibility="{Binding EditorVisible, Converter={StaticResource BoolAVis}}">
            <Border Style="{StaticResource Tarjeta}" Width="440" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Padding="24" MaxHeight="680">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloEditor}" Style="{StaticResource H2}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Número / nombre" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" Text="{Binding EdNumero, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Piso" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" Text="{Binding EdPiso, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tipo" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <ComboBox MinHeight="48" FontSize="15" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding TiposHabitacion}" SelectedIndex="{Binding EdTipoIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Capacidad" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" Text="{Binding EdCapacidad, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio por noche (S/)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" Text="{Binding EdPrecioNoche, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio por hora (S/)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" Text="{Binding EdPrecioHora, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Deja el precio por hora en 0 si no ofreces esa modalidad." Style="{StaticResource Muted}"
                                   FontSize="11" Margin="0,0,0,12" />

                        <!-- Subir foto de la habitación -->
                        <TextBlock Text="Foto de la habitación" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <Border Background="#F4F6F9" BorderBrush="{StaticResource Brush.Borde}" BorderThickness="1.5"
                                CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Preview -->
                                <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10" Background="White"
                                        BorderBrush="{StaticResource Brush.Borde}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Image Width="34" Height="34" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Source="pack://application:,,,/Assets/Iconos/ico-imagen.png"
                                               Visibility="{Binding EdTieneImagen, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                                        <Image Source="{Binding EdImagenRuta, Converter={StaticResource Img}}" Stretch="UniformToFill"
                                               Visibility="{Binding EdTieneImagen, Converter={StaticResource BoolAVis}}" />
                                    </Grid>
                                </Border>
                                <!-- Acciones -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Cursor="Hand" HorizontalAlignment="Left" Command="{Binding CargarFotoCommand}"
                                            Background="{StaticResource Brush.Primary}" BorderThickness="0" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="18" Height="18" Margin="0,0,8,0"
                                                   Source="pack://application:,,,/Assets/Iconos/ico-subir.png" />
                                            <TextBlock Text="Subir foto" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="PNG o JPG. Se mostrará en el mapa de Cobrar." Style="{StaticResource Muted}"
                                               FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0" />
                                    <Button Content="Quitar foto" Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource Brush.Error}" FontSize="12" Cursor="Hand"
                                            HorizontalAlignment="Left" Padding="2,0" Margin="0,4,0,0"
                                            Command="{Binding QuitarFotoCommand}"
                                            Visibility="{Binding EdTieneImagen, Converter={StaticResource BoolAVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Comodidades / adicionales (chips predefinidos) -->
                        <TextBlock Text="Comodidades / adicionales" Style="{StaticResource Muted}" Margin="0,0,0,2" />
                        <TextBlock Text="Toca para marcar lo que incluye la habitación." Style="{StaticResource Muted}"
                                   FontSize="11" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ComodidadesEditor}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding Seleccionada}" Cursor="Hand" Margin="0,0,6,6">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="chip" CornerRadius="14" BorderThickness="1.5"
                                                        BorderBrush="#D5DBE3" Background="#F4F6F9" Padding="12,7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="mark" Text="✓ " FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" Visibility="Collapsed" />
                                                        <TextBlock x:Name="txt" Text="{Binding Nombre}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#12233F" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.Primary}" />
                                                        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                        <Setter TargetName="txt" Property="Foreground" Value="White" />
                                                        <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Notas (opcional)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputEstandar}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding EdNotas, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" MinWidth="110" Margin="0,0,10,0"
                                    Command="{Binding CancelarEditorCommand}" />
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" MinWidth="110"
                                    Command="{Binding GuardarHabitacionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
