<UserControl x:Class="PagoYa.Desktop.Views.CobroRapidoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
             xmlns:views="clr-namespace:PagoYa.Desktop.Views"
             xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:CobroRapidoViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="#E6EAF0">

    <UserControl.Resources>
        <conv:MonedaSolesConverter x:Key="Moneda" />
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
        <conv:BoolInversoConverter x:Key="BoolInv" />
        <conv:CategoriaABrushConverter x:Key="CatColor" />
        <conv:RutaAImagenConverter x:Key="Img" />
        <conv:EstadoHabitacionAColorConverter x:Key="EstadoColor" />

        <!-- Tarjeta de producto (celdas pegadas = grilla dibujada) -->
        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#D5DBE3" BorderThickness="1" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de categoría (vertical, con foto/emoji) -->
        <Style x:Key="CatBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#D5DBE3" BorderThickness="1" Padding="4,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                <Setter TargetName="bd" Property="Background" Value="#FFF1EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tecla numérica (clara, acento naranja al presionar) -->
        <Style x:Key="TeclaNum" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#12233F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F4F7FB" BorderBrush="#D5DBE3" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7D8" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="118" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= IZQUIERDA: TICKET + COBRO ================= -->
        <Border Grid.Column="0" Background="#12233F">
            <DockPanel>
                <!-- Encabezado -->
                <Border DockPanel.Dock="Top" Background="#0C1A30" Padding="14,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F9FE;" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="NOTA DE VENTA" Foreground="White" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Cursor="Hand" BorderThickness="0" Padding="8,3"
                                Command="{Binding ToggleTactilCommand}" ToolTip="Activar/ocultar teclado táctil">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#25456F" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoTactil}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x2328; Táctil" FontSize="12" FontWeight="Bold" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Cluster de cobro (abajo) ===== -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- TOTAL -->
                    <Border Background="#16A34A" Padding="14,12">
                        <Grid>
                            <TextBlock Text="TOTAL" Foreground="#CFF3DD" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Total, Converter={StaticResource Moneda}}"
                                       Foreground="White" FontSize="34" FontWeight="ExtraBold" />
                        </Grid>
                    </Border>

                    <!-- Métodos de pago en UNA fila (tintes vibrantes; seleccionado a todo color) -->
                    <UniformGrid Rows="1" Margin="10,10,10,0">
                        <Button Height="54" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0"
                                Command="{Binding SeleccionarMetodoPagoCommand}" CommandParameter="Efectivo">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#DDF7E6" BorderBrush="#16A34A" BorderThickness="2">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F4B5;" FontSize="19" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="lbl" Text="Efectivo" FontSize="12" FontWeight="Bold" Foreground="#0F7A38" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#BFEFD3" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MetodoPagoSeleccionado}" Value="Efectivo">
                                            <Setter TargetName="bd" Property="Background" Value="#16A34A" />
                                            <Setter TargetName="lbl" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="54" Margin="2,0" Cursor="Hand" BorderThickness="0"
                                Command="{Binding SeleccionarMetodoPagoCommand}" CommandParameter="Yape / Plin">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#EEE5FF" BorderBrush="#7C3AED" BorderThickness="2">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F4F1;" FontSize="19" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="lbl" Text="Yape/Plin" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DCC9FB" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MetodoPagoSeleccionado}" Value="Yape / Plin">
                                            <Setter TargetName="bd" Property="Background" Value="#7C3AED" />
                                            <Setter TargetName="lbl" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Height="54" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0"
                                Command="{Binding SeleccionarMetodoPagoCommand}" CommandParameter="Tarjeta">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#E0ECFF" BorderBrush="#2563EB" BorderThickness="2">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F4B3;" FontSize="19" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="lbl" Text="Tarjeta" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C7DBFF" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding MetodoPagoSeleccionado}" Value="Tarjeta">
                                            <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                            <Setter TargetName="lbl" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>

                    <!-- Paga con + Vuelto -->
                    <Grid Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PAGA CON" Foreground="#9FB2CC" FontSize="11" FontWeight="Bold" Margin="2,0,0,3" />
                            <Border Background="#25456F" Padding="10,2">
                                <TextBox Text="{Binding PagaConTexto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="22" FontWeight="Bold"
                                         Foreground="White" CaretBrush="White" VerticalContentAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VUELTO" Foreground="#9FB2CC" FontSize="11" FontWeight="Bold" Margin="2,0,0,3" />
                            <Border Background="#123B25" Padding="10,2" MinHeight="42">
                                <TextBlock Text="{Binding Vuelto, Converter={StaticResource Moneda}}"
                                           FontSize="22" FontWeight="ExtraBold" Foreground="#4ADE80" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Teclado numérico (modo táctil) -->
                    <UniformGrid Columns="3" Margin="8,8,8,0"
                                 Visibility="{Binding ModoTactil, Converter={StaticResource BoolAVis}}">
                        <Button Content="7" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="7" />
                        <Button Content="8" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="8" />
                        <Button Content="9" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="9" />
                        <Button Content="4" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="4" />
                        <Button Content="5" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="5" />
                        <Button Content="6" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="6" />
                        <Button Content="1" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="1" />
                        <Button Content="2" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="2" />
                        <Button Content="3" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="3" />
                        <Button Content="." Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="." />
                        <Button Content="0" Style="{StaticResource TeclaNum}" Command="{Binding TeclaMontoCommand}" CommandParameter="0" />
                        <Button Height="46" Margin="3" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Cursor="Hand"
                                Command="{Binding BorrarMontoCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FEE2E2" BorderBrush="#F3B0B0" BorderThickness="1">
                                        <TextBlock Text="&#x232B;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FBC7C7" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DC2626" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>

                    <!-- COBRAR -->
                    <Button Cursor="Hand" BorderThickness="0" Height="76" Margin="10,10,10,0"
                            Command="{Binding CobrarCommand}" IsEnabled="{Binding CarritoTieneItems}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{StaticResource Brush.Primary}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="COBRAR" Foreground="White" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="F4" Foreground="White" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#D8500F" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#3A5170" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Cancelar  ·  F8" Cursor="Hand" Height="38" Margin="10,8,10,12"
                            Background="Transparent" Foreground="#F87171" FontWeight="Bold" FontSize="13"
                            BorderBrush="#7F1D1D" BorderThickness="1" Command="{Binding CancelarVentaCommand}" />
                </StackPanel>

                <!-- Columnas de la lista -->
                <Grid DockPanel.Dock="Top" Margin="14,10,14,4">
                    <TextBlock Text="PRODUCTO" Foreground="#7E92AE" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="IMPORTE" Foreground="#7E92AE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>

                <!-- Lista del carrito (fill) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,6">
                    <ItemsControl ItemsSource="{Binding Carrito}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" Padding="9,7" Margin="0"
                                        BorderBrush="#25456F" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="13"
                                                       Foreground="#12233F" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="#8A94A6" FontSize="11">
                                                <Run Text="{Binding PrecioUnitario, Converter={StaticResource Moneda}, Mode=OneWay}" /><Run Text=" c/u" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#8722;" Width="30" Height="30" FontSize="18" FontWeight="Bold"
                                                    Background="#EEF1F5" Foreground="#12233F" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Cantidad}" MinWidth="30" TextAlignment="Center"
                                                       VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#12233F" />
                                            <Button Content="+" Width="30" Height="30" FontSize="16" FontWeight="Bold"
                                                    Background="{StaticResource Brush.Primary}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                    Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding ImporteLinea, Converter={StaticResource Moneda}}"
                                                       MinWidth="66" TextAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="14" FontWeight="Bold" Foreground="#12233F" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= CATEGORÍAS (con fotos) ================= -->
        <Border Grid.Column="2" Background="White" BorderBrush="#D5DBE3" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CATEGORÍAS" Foreground="#8A94A6" FontSize="11" FontWeight="Bold"
                           Margin="8,10,8,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CatBtn}"
                                        Command="{Binding DataContext.SeleccionarCategoriaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Nombre}">
                                    <StackPanel>
                                        <Grid Width="58" Height="52" HorizontalAlignment="Center">
                                            <Border Background="{Binding Nombre, Converter={StaticResource CatColor}, ConverterParameter=Tint}"
                                                    Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                                                <TextBlock Text="{Binding Icono}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding ImagenRuta, Converter={StaticResource Img}}" Stretch="UniformToFill"
                                                   Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="SemiBold" Foreground="#12233F"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= BUSCADOR + GRILLA ================= -->
        <DockPanel Grid.Column="4">
            <!-- Aviso tras cobrar (impresión/facturación) -->
            <Border DockPanel.Dock="Bottom" Background="#12233F" Padding="14,9" Margin="0,10,0,0"
                    Visibility="{Binding MensajeEstado, Converter={StaticResource BoolAVis}}">
                <TextBlock Text="{Binding MensajeEstado}" Foreground="White" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5DBE3" BorderThickness="1"
                    Padding="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="22" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox x:Name="BuscadorBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             FontSize="19" VerticalContentAlignment="Center" Padding="6,10"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" IsHitTestVisible="False" Text="Buscar o escanear producto…"
                               Foreground="#9AA5B4" FontSize="19" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding TextoBusqueda.Length, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}" />
                    <Border Grid.Column="2" Background="#EEF1F5" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="F2" Foreground="#12233F" FontWeight="Bold" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding MostrandoHabitaciones, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                <ItemsControl ItemsSource="{Binding ProductosView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileBtn}" Width="188" Height="210"
                                    Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Bottom" Background="#0C1A30" Padding="7,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                            <!-- Principio activo (DCI) para orientar la venta de genéricos -->
                                            <TextBlock Text="{Binding PrincipioActivo}" Foreground="#9FB2CC" FontSize="10"
                                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                       Visibility="{Binding TienePrincipioActivo, Converter={StaticResource BoolAVis}}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding PrecioNormal, Converter={StaticResource Moneda}}"
                                                           Foreground="#9FB2CC" FontSize="12" TextDecorations="Strikethrough"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding TieneDescuento, Converter={StaticResource BoolAVis}}" />
                                                <TextBlock Text="{Binding Precio, Converter={StaticResource Moneda}}"
                                                           Foreground="White" FontSize="21" FontWeight="ExtraBold" TextAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Grid Background="White">
                                        <Border Background="{Binding Categoria, Converter={StaticResource CatColor}, ConverterParameter=Tint}"
                                                Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                                            <TextBlock Text="{Binding Icono}" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding ImagenRuta, Converter={StaticResource Img}}" Stretch="Uniform" Margin="4"
                                               Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}}" />
                                        <!-- Velo de bloqueo: agotado o vencido (no vendible) -->
                                        <Border Background="#B0FFFFFF"
                                                Visibility="{Binding NoVendible, Converter={StaticResource BoolAVis}}" />
                                        <!-- Badge de oferta (esquina superior izquierda) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="7,2"
                                                Background="{StaticResource Brush.Primary}"
                                                Visibility="{Binding TieneDescuento, Converter={StaticResource BoolAVis}}">
                                            <TextBlock Text="{Binding EtiquetaDescuento}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <!-- Badge Rx (requiere receta) -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="6,2" Margin="0,26,0,0"
                                                Background="#2563EB"
                                                Visibility="{Binding RequiereReceta, Converter={StaticResource BoolAVis}}">
                                            <TextBlock Text="Rx Receta" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <!-- Badge Personalizable (rubro comida): el producto abre un diálogo de modificadores -->
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,2"
                                                Background="{StaticResource Brush.Primary}"
                                                Visibility="{Binding TienePersonalizacion, Converter={StaticResource BoolAVis}}">
                                            <TextBlock Text="&#x2699; Personalizar" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <!-- Badge VENCIDO (centro, rojo) -->
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="10,4"
                                                Background="{StaticResource Brush.Error}"
                                                Visibility="{Binding EstaVencido, Converter={StaticResource BoolAVis}}">
                                            <TextBlock Text="VENCIDO" Foreground="White" FontSize="14" FontWeight="ExtraBold" />
                                        </Border>
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Padding="7,2"
                                                Visibility="{Binding EtiquetaStock, Converter={StaticResource BoolAVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EtiquetaStock}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Grilla de HABITACIONES (categoría "Habitaciones"): tiles para alquilar -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding MostrandoHabitaciones, Converter={StaticResource BoolAVis}}">
                <ItemsControl ItemsSource="{Binding Habitaciones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileBtn}" Width="188" Height="150" Margin="0"
                                    Command="{Binding DataContext.SeleccionarHabitacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="30" Background="{Binding Estado, Converter={StaticResource EstadoColor}}">
                                        <Grid Margin="10,0">
                                            <TextBlock Text="{Binding EstadoTexto}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TipoTexto}" Foreground="#F0FFFFFF" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                    <Grid Background="{Binding Estado, Converter={StaticResource EstadoColor}, ConverterParameter=Tint}">
                                        <Image Source="{Binding ImagenRuta, Converter={StaticResource Img}}" Stretch="UniformToFill"
                                               Visibility="{Binding TieneImagen, Converter={StaticResource BoolAVis}}" />
                                        <Border VerticalAlignment="Bottom" Background="#D90C1A30" Padding="9,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Numero}" FontSize="22" FontWeight="ExtraBold" Foreground="White" />
                                                <TextBlock Text="{Binding HuespedTexto}" FontSize="11" Foreground="#FFD3D3" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HuespedTexto, Converter={StaticResource BoolAVis}}" />
                                                <TextBlock Text="{Binding PrecioTexto}" FontSize="11" Foreground="#CBD5E6" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ===== Diálogo: alquilar habitación (agrega al carrito) ===== -->
        <Grid Grid.Column="0" Grid.ColumnSpan="5" Background="#88000000"
              Visibility="{Binding HabDialogoVisible, Converter={StaticResource BoolAVis}}">
            <Border Style="{StaticResource Tarjeta}" Width="410" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding HabDialogTitulo}" Style="{StaticResource H2}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding HabDialogTarifaTexto}" Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="Por noche" GroupName="hd" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                     IsChecked="{Binding HabDialogPorHora, Converter={StaticResource BoolInv}}" />
                        <RadioButton Content="Por hora (hostal)" GroupName="hd" VerticalContentAlignment="Center"
                                     IsChecked="{Binding HabDialogPorHora}" />
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cantidad" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputEstandar}" Text="{Binding HabDialogCantidad, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Total habitación" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HabDialogTotalTexto}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Primary}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Huésped (opcional)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputEstandar}" Margin="0,0,0,10" Text="{Binding HabDialogHuesped, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Documento (opcional)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputEstandar}" Text="{Binding HabDialogDocumento, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Se agrega al carrito; cobras habitación + productos en una sola boleta."
                               Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" MinWidth="110" Margin="0,0,10,0"
                                Command="{Binding CancelarHabDialogCommand}" />
                        <Button Content="Agregar al carrito" Style="{StaticResource BotonPrimario}" MinWidth="150"
                                Command="{Binding AgregarHabitacionAlCarritoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Diálogo: personalizar producto (rubro comida) ===== -->
        <Grid Grid.Column="0" Grid.ColumnSpan="5" Background="#88000000"
              Visibility="{Binding PersonalizarVisible, Converter={StaticResource BoolAVis}}">
            <Border Style="{StaticResource Tarjeta}" Width="460" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <DockPanel>
                    <!-- Encabezado -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding PersonalizarTitulo}" Style="{StaticResource H2}" />
                        <TextBlock Text="Personaliza el pedido y agrégalo al carrito." Style="{StaticResource Muted}"
                                   FontSize="12" Margin="0,2,0,12" />
                    </StackPanel>

                    <!-- Pie: precio + cantidad + acciones -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Brush.Borde}" Margin="0,12,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}"
                                         Text="{Binding PersonalizarCantidad, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Unitario:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding PersonalizarPrecioTexto}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Total" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding PersonalizarTotalTexto}" FontSize="22" FontWeight="ExtraBold"
                                           Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" MinWidth="110" Margin="0,0,10,0"
                                    Command="{Binding CancelarPersonalizacionCommand}" />
                            <Button Content="Agregar al carrito" Style="{StaticResource BotonPrimario}" MinWidth="160"
                                    Command="{Binding ConfirmarPersonalizacionCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Cuerpo: grupos + nota (scrollable) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding PersonalizarGrupos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="14"
                                                           Foreground="#12233F" VerticalAlignment="Center" />
                                                <Border Background="#FDE2E2" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Obligatorio, Converter={StaticResource BoolAVis}}">
                                                    <TextBlock Text="Obligatorio" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Error}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Opciones de SELECCIÓN ÚNICA (radios) -->
                                            <ItemsControl ItemsSource="{Binding Opciones}"
                                                          Visibility="{Binding Multiple, Converter={StaticResource BoolAVis}, ConverterParameter=Inv}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <RadioButton Grid.Column="0" Content="{Binding Nombre}" FontSize="14"
                                                                         VerticalContentAlignment="Center"
                                                                         GroupName="{Binding Padre.GrupoRadio}"
                                                                         IsChecked="{Binding Seleccionada}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ExtraTexto}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center"
                                                                       Visibility="{Binding TieneExtra, Converter={StaticResource BoolAVis}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Opciones de SELECCIÓN MÚLTIPLE (checkboxes) -->
                                            <ItemsControl ItemsSource="{Binding Opciones}"
                                                          Visibility="{Binding Multiple, Converter={StaticResource BoolAVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" Content="{Binding Nombre}" FontSize="14"
                                                                      VerticalContentAlignment="Center"
                                                                      IsChecked="{Binding Seleccionada}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ExtraTexto}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center"
                                                                       Visibility="{Binding TieneExtra, Converter={StaticResource BoolAVis}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Nota para la cocina -->
                            <StackPanel Visibility="{Binding PersonalizarPermiteNota, Converter={StaticResource BoolAVis}}">
                                <TextBlock Text="Nota para la cocina" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputEstandar}" MinHeight="48" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Text="{Binding PersonalizarNota, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
