<Window x:Class="PagoYa.Desktop.TicketPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vista previa del ticket"
        Height="640" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E6EAF0">
    <Window.Resources>
        <conv:RutaAImagenConverter x:Key="Img" />
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Botones -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="Estado" Foreground="#12233F" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar" Style="{StaticResource BotonSecundario}" MinWidth="100" Margin="0,0,10,0"
                        Click="Cerrar_Click" />
                <Button x:Name="BtnImprimir" Content="&#x1F5A8; Imprimir" Style="{StaticResource BotonPrimario}"
                        MinWidth="140" Click="Imprimir_Click" />
            </StackPanel>
        </Grid>

        <!-- Papel del ticket -->
        <Border Background="White" Padding="18,16">
            <Border.Effect>
                <DropShadowEffect Color="#334155" BlurRadius="18" ShadowDepth="0" Opacity="0.25" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Image x:Name="LogoImg" Stretch="Uniform" MaxHeight="90" Margin="0,0,0,10"
                           HorizontalAlignment="Center" />
                    <TextBlock x:Name="TicketTexto" FontFamily="Consolas" FontSize="13" Foreground="#12233F"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
