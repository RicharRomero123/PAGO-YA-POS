<Window x:Class="PagoYa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PagoYa.Desktop.Converters"
        xmlns:views="clr-namespace:PagoYa.Desktop.Views"
        xmlns:vm="clr-namespace:PagoYa.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="PagoYa — POS"
        Icon="/Assets/logo.png"
        WindowState="Maximized"
        MinHeight="768" MinWidth="1024"
        Height="820" Width="1280"
        Background="{StaticResource Brush.Fondo}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:IgualdadAVisibilidadConverter x:Key="IgualVis" />
        <conv:BoolAVisibilidadConverter x:Key="BoolAVis" />
        <conv:PackUriAImagenConverter x:Key="PackImg" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= MENÚ LATERAL ================= -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Navy}">
            <DockPanel>
                <!-- Logo + identidad del negocio (icono del rubro + nombre) -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/logo.png" Width="40" Height="40" VerticalAlignment="Center" />
                        <TextBlock Text="PagoYa" FontFamily="{StaticResource FuenteMarca}"
                                   FontSize="26" FontWeight="ExtraBold" Foreground="White"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <!-- Identidad adaptativa: el icono cambia según el rubro elegido en el onboarding -->
                    <Border Background="#16283F" CornerRadius="10" Padding="10,8" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="White" CornerRadius="8" Width="34" Height="34" Padding="4">
                                <Image Source="{Binding RubroIcono, Converter={StaticResource PackImg}}"
                                       Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding NombreNegocio}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="120" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pie: usuario actual + cerrar sesión -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,10" CornerRadius="0"
                        Background="#16283F" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsuarioActual}" Foreground="White" FontSize="13" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RolActual}" Foreground="#9FB2CC" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Salir" Cursor="Hand"
                                Command="{Binding CerrarSesionCommand}"
                                Background="Transparent" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Foreground="White" Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Pie: plan actual -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20" CornerRadius="0"
                        Background="#1F3355" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plan " Foreground="#9FB2CC" FontSize="13" />
                            <TextBlock Text="{Binding PlanActual}" Foreground="White" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResumenLicencia}" Foreground="#7E92AE" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border Background="{StaticResource Brush.Warning}" CornerRadius="2" Padding="6,3" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding EnPeriodoGracia, Converter={StaticResource BoolAVis}}">
                            <TextBlock Text="En periodo de gracia" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Ítems de navegación -->
                <ItemsControl ItemsSource="{Binding Modulos}" Margin="12,4,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Clave}"
                                    Cursor="Hand" HorizontalContentAlignment="Stretch"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fondo" CornerRadius="0" Padding="12,11" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Source="{Binding IconoImagen, Converter={StaticResource PackImg}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Titulo}" Foreground="#E7EDF5"
                                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Margin="4,0,0,0" />
                                                <!-- Candado + badge si está bloqueado -->
                                                <Border Grid.Column="2" CornerRadius="2" Background="#33FFFFFF" Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding Bloqueado, Converter={StaticResource BoolAVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="12" Height="12" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="pack://application:,,,/Assets/Iconos/ico-candado.png" />
                                                        <TextBlock Text="{Binding TierRequerido}" Foreground="White"
                                                                   FontSize="10" FontWeight="Bold" Margin="3,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fondo" Property="Background" Value="#1F3355" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                <Setter TargetName="fondo" Property="Background" Value="{StaticResource Brush.Primary}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ================= ÁREA DE CONTENIDO ================= -->
        <Grid Grid.Column="1">
            <!-- Cada pantalla se muestra según ModuloActivo -->
            <views:CobroRapidoView   DataContext="{Binding Cobro}"         Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=cobro}" />
            <views:CajaView          DataContext="{Binding Caja}"          Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=caja}" />
            <views:InventarioView    DataContext="{Binding Inventario}"    Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=inventario}" />
            <views:ReportesView      DataContext="{Binding Reportes}"      Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=reportes}" />
            <views:ConfiguracionView DataContext="{Binding Configuracion}" Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=configuracion}" />
            <views:UsuariosView      DataContext="{Binding Usuarios}"      Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=usuarios}" />
            <views:ProveedoresView   DataContext="{Binding Proveedores}"   Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=proveedores}" />
            <views:HabitacionesView  DataContext="{Binding Habitaciones}"   Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=habitaciones}" />
            <views:MesasView         DataContext="{Binding Mesas}"          Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=mesas}" />
            <views:VencimientosView  DataContext="{Binding Vencimientos}"   Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=vencimientos}" />

            <!-- Módulos premium (solo navegables con la licencia respectiva) -->
            <views:FacturacionView DataContext="{Binding Facturacion}" Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=facturacion}" />
            <views:NubeView        DataContext="{Binding Nube}"        Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=cloud}" />
            <!-- Multisede es parte de la oferta Cloud: reutiliza el panel de nube/consolidación -->
            <views:NubeView        DataContext="{Binding Nube}"        Visibility="{Binding DataContext.ModuloActivo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IgualVis}, ConverterParameter=multisede}" />

            <!-- Overlay de upsell (por encima de todo) -->
            <views:UpsellView DataContext="{Binding Upsell}" />
        </Grid>
    </Grid>
</Window>
